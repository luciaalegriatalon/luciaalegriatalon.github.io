---
import type { Lang, LocalizedAsset, Project } from '../data/portfolio';
import Localized from './Localized.astro';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const isStack = project.thumbnail.length > 1 && project.thumbnailMode !== 'web-devices';
type ThumbnailImage = {
  src: string;
  index: number;
  lang?: Lang;
};
const getThumbnailImages = (assets: LocalizedAsset[]): ThumbnailImage[] =>
  assets.flatMap((asset, index) =>
    typeof asset === 'string'
      ? [{ src: asset, index }]
      : [
          { src: asset.en, index, lang: 'en' },
          { src: asset.es, index, lang: 'es' }
        ]
  );
const thumbnailImages = getThumbnailImages(project.thumbnail);
---

<a class="project-card" href={`/work/${project.slug}/`}>
  <div class:list={['project-thumb', isStack && 'stacked', project.thumbnailMode]}>
    {thumbnailImages.map((image) => (
      <span
        class:list={['thumb-image', image.lang && 'localized-media']}
        data-lang={image.lang}
        aria-hidden="true"
        style={`--i: ${image.index}; background-image: url('${image.src}')`}
      />
    ))}
  </div>
  <div class="project-copy">
    <p class="meta"><Localized value={project.category} /></p>
    <h2><Localized value={project.title} /></h2>
    <p><Localized value={project.summary} /></p>
  </div>
</a>
