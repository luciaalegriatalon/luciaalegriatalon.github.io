---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { profile, ui } from '../data/portfolio';

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT;
const hasFormspreeEndpoint = Boolean(formspreeEndpoint);
const formAction = hasFormspreeEndpoint ? formspreeEndpoint : `mailto:${profile.email}`;
const description =
  'Contact Lucía Alegria for UX/UI design, product ideas and digital communication projects.';
---

<BaseLayout active="contact" title="Lucía Alegria - Contact" description={description} image="/assets/fotolu-form.webp">
  <section class="contact-shell">
    <div class="contact-copy prose">
      <p class="meta"><Localized value={ui.contactEyebrow} /></p>
      <h1><Localized value={ui.contactTitle} /></h1>
      <p><Localized value={ui.contactBody} /></p>
      <a class="button" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <form
      class="contact-form"
      action={formAction}
      method={hasFormspreeEndpoint ? 'POST' : 'post'}
      enctype={hasFormspreeEndpoint ? undefined : 'text/plain'}
    >
      {
        hasFormspreeEndpoint && (
          <>
            <input type="hidden" name="subject" value="Nuevo mensaje desde el portfolio de {{ name }}" />
            <input class="contact-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </>
        )
      }
      <label>
        <Localized value={ui.labels.email} />
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        <Localized value={ui.labels.name} />
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        <Localized value={ui.labels.message} />
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button type="submit"><Localized value={ui.labels.send} /></button>
    </form>
  </section>
</BaseLayout>
