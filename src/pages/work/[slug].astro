---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import Localized from '../../components/Localized.astro';
import type { Lang, LocalizedAsset } from '../../data/portfolio';
import { getAsset, getText, projects, ui } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
type AssetVariant = {
  src: string;
  lang?: Lang;
};
const getAssetVariants = (asset: LocalizedAsset): AssetVariant[] =>
  typeof asset === 'string'
    ? [{ src: asset }]
    : [
        { src: asset.en, lang: 'en' },
        { src: asset.es, lang: 'es' }
      ];
const projectImage = getAsset(project.heroImage ?? project.thumbnail[0]);
const projectHeroImages = project.heroImage ? getAssetVariants(project.heroImage) : [];
const getProjectHeroAlt = (lang: Lang = 'en') => getText(project.heroAlt ?? project.title, lang);
---

<BaseLayout
  title={`Lucía Alegria - ${getText(project.title)}`}
  description={getText(project.summary)}
  image={projectImage}
  type="article"
>
  <article class:list={['project-page', `project-${project.slug}`]}>
    <header class="project-hero">
      <div class="project-hero-copy">
        <p class="meta"><Localized value={project.category} /></p>
        <h1><Localized value={project.title} /></h1>
        <p><Localized value={project.summary} /></p>
        <div class="tag-list">
          {project.tags.map((tag) => <span><Localized value={tag} /></span>)}
        </div>
      </div>
      {projectHeroImages.map((image) => (
        <figure class:list={[image.lang && 'localized-media']} data-lang={image.lang}>
          <button
            class="image-expand"
            type="button"
            data-lightbox-trigger
            data-lightbox-src={image.src}
            data-lightbox-alt={getProjectHeroAlt(image.lang)}
            aria-label={`Open ${getProjectHeroAlt(image.lang)} full screen`}
          >
            <img src={image.src} alt={getProjectHeroAlt(image.lang)} />
          </button>
        </figure>
      ))}
    </header>

    {project.sections.map((section) => <ProjectSection section={section} />)}

    <nav class="project-more" aria-label="More work">
      <a class="project-more-home" href="/"><Localized value={ui.moreWork} /></a>
      <div>
        {projects
          .filter((item) => item.slug !== project.slug)
          .slice(0, 3)
          .map((item) => <a href={`/work/${item.slug}/`}><Localized value={item.title} /></a>)}
      </div>
    </nav>
  </article>
</BaseLayout>
