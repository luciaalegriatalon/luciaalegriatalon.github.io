---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { ui } from '../data/portfolio';

const description =
  'Resume of Lucía Alegria, communications specialist and UX designer based in Barcelona.';
---

<BaseLayout active="cv" title="Lucía Alegria - CV" description={description}>
  <section class="page-shell">
    <div class="page-heading">
      <p class="meta"><Localized value={ui.cvEyebrow} /></p>
      <h1><Localized value={ui.cvTitle} /></h1>
    </div>
    <div class="cv-download">
      <a
        class="button localized-media"
        data-lang="en"
        href="/assets/Resume Lucía Alegria Talon.pdf"
        download="Resume Lucía Alegria Talon.pdf"
      >
        Download resume
      </a>
      <a
        class="button localized-media"
        data-lang="es"
        href="/assets/CV Lucía Alegria Talon.pdf"
        download="CV Lucía Alegria Talon.pdf"
      >
        Descargar currículum
      </a>
    </div>
  </section>
</BaseLayout>
