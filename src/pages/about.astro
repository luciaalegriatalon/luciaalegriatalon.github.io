---
import BaseLayout from '../layouts/BaseLayout.astro';
import Localized from '../components/Localized.astro';
import { aboutSections, ui } from '../data/biblioteca';

const description =
  'About Lucía Alegria, a communications specialist and UX/UI designer based in Barcelona with experience in digital communication, cultural projects and technology.';
---

<BaseLayout active="about" title="Lucía Alegria - About" description={description}>
  <section class="page-shell">
    <h1><Localized value={ui.aboutTitle} /></h1>
    <div class="about-stack">
      {aboutSections.map((section, index) => (
        <article class:list={['about-section', index % 2 === 1 && 'reverse']}>
          <figure>
            <img src={section.image} alt={section.alt} loading="lazy" />
            {section.caption && <figcaption><Localized value={section.caption} /></figcaption>}
          </figure>
          <Localized value={section.html} html class="prose" />
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
